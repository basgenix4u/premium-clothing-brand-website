// Vellum storefront data model (see docs/ARCHITECTURE.md §5).
// Money is stored as integer minor units (USD cents). Emails are stored lowercased by the application.

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum Audience {
  WOMEN
  MEN
  UNISEX
}

enum Badge {
  NEW
  BESTSELLER
  LIMITED
}

enum PromoKind {
  PERCENT
  FIXED
  SHIPPING
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String?   @map("full_name") @db.VarChar(120)
  role            UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  cart                Cart?
  wishlistItems       WishlistItem[]
  orders              Order[]
  reviews             Review[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipHash    String?   @map("ip_hash") @db.VarChar(64)
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?  @db.VarChar(60)
  line1      String   @db.VarChar(160)
  line2      String?  @db.VarChar(160)
  city       String   @db.VarChar(100)
  region     String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  country    String   @db.Char(2)
  phone      String?  @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("addresses")
}

model Region {
  code       String  @id @db.VarChar(10)
  label      String  @db.VarChar(80)
  currency   String  @db.Char(3)
  locale     String  @db.VarChar(20)
  fxRate     Decimal @map("fx_rate") @db.Decimal(12, 6)
  taxNote    String  @map("tax_note") @db.VarChar(255)
  sizeSystem String  @map("size_system") @db.VarChar(4)

  shippingMethods ShippingMethod[]

  @@map("regions")
}

model ShippingMethod {
  id         String  @id @db.VarChar(60)
  regionCode String  @map("region_code") @db.VarChar(10)
  label      String  @db.VarChar(80)
  eta        String  @db.VarChar(80)
  priceMinor Int     @map("price_minor")
  note       String? @db.VarChar(255)
  isActive   Boolean @default(true) @map("is_active")

  region Region  @relation(fields: [regionCode], references: [code])
  carts  Cart[]
  orders Order[]

  @@index([regionCode])
  @@map("shipping_methods")
}

model Category {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @unique @db.VarChar(60)
  name      String @db.VarChar(80)
  blurb     String @db.VarChar(255)
  imageUrl  String @map("image_url") @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  products Product[]

  @@map("categories")
}

model Product {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique @db.VarChar(120)
  name        String     @db.VarChar(160)
  subtitle    String     @db.VarChar(255)
  description String     @db.Text
  composition String     @db.VarChar(500)
  details     String[]
  care        String[]
  fitNote     String     @map("fit_note") @db.VarChar(500)
  fitModel    String     @map("fit_model") @db.VarChar(255)
  fitRuns     String     @map("fit_runs") @db.VarChar(255)
  priceMinor  Int        @map("price_minor")
  currency    String     @default("USD") @db.Char(3)
  audiences   Audience[]
  styles      String[]
  badges      Badge[]
  popularity  Int        @default(0)
  releasedAt  DateTime   @map("released_at")
  isPublished Boolean    @default(true) @map("is_published")
  categoryId  String     @map("category_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  reviews  Review[]

  @@index([categoryId, isPublished])
  @@index([releasedAt])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colour    String   @db.VarChar(30)
  sku       String   @unique @db.VarChar(40)
  imageUrls String[] @map("image_urls")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes      VariantSize[]
  cartItems  CartItem[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]

  @@unique([productId, colour])
  @@map("product_variants")
}

model VariantSize {
  variantId String @map("variant_id") @db.Uuid
  size      String @db.VarChar(10)
  stock     Int
  version   Int    @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, size])
  @@map("variant_sizes")
}

model Look {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(160)
  season      String   @db.VarChar(80)
  imageUrl    String   @map("image_url") @db.VarChar(500)
  copy        String   @db.Text
  styling     String   @db.Text
  items       Json
  publishedAt DateTime @map("published_at")
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("looks")
}

model Article {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(200)
  kicker      String   @db.VarChar(120)
  readTime    String   @map("read_time") @db.VarChar(40)
  imageUrl    String   @map("image_url") @db.VarChar(500)
  excerpt     String   @db.Text
  body        String[]
  related     String[]
  publishedAt DateTime @map("published_at")
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("articles")
}

model PromoCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.VarChar(40)
  kind             PromoKind
  value            Int
  minSubtotalMinor Int       @default(0) @map("min_subtotal_minor")
  description      String    @db.VarChar(255)
  isActive         Boolean   @default(true) @map("is_active")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  usageLimit       Int?      @map("usage_limit")
  usedCount        Int       @default(0) @map("used_count")

  carts  Cart[]
  orders Order[]

  @@map("promo_codes")
}

model Cart {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  guestTokenHash   String?  @unique @map("guest_token_hash") @db.VarChar(64)
  promoCodeId      String?  @map("promo_code_id") @db.Uuid
  shippingMethodId String?  @map("shipping_method_id") @db.VarChar(60)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode      PromoCode?      @relation(fields: [promoCodeId], references: [id])
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  items          CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  size      String   @db.VarChar(10)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, size])
  @@map("cart_items")
}

model WishlistItem {
  userId         String   @map("user_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  notifyWhenBack Boolean  @default(false) @map("notify_when_back")
  createdAt      DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  @@map("wishlist_items")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(20)
  userId           String?     @map("user_id") @db.Uuid
  email            String      @db.VarChar(254)
  status           OrderStatus @default(PENDING_PAYMENT)
  currency         String      @db.Char(3)
  subtotalMinor    Int         @map("subtotal_minor")
  discountMinor    Int         @default(0) @map("discount_minor")
  shippingMinor    Int         @map("shipping_minor")
  totalMinor       Int         @map("total_minor")
  promoCodeId      String?     @map("promo_code_id") @db.Uuid
  shippingMethodId String      @map("shipping_method_id") @db.VarChar(60)
  shippingAddress  Json        @map("shipping_address")
  idempotencyKey   String      @unique @map("idempotency_key") @db.VarChar(80)
  guestTokenHash   String?     @map("guest_token_hash") @db.VarChar(64)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user           User?          @relation(fields: [userId], references: [id])
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  sku            String  @db.VarChar(40)
  productName    String  @map("product_name") @db.VarChar(160)
  colour         String  @db.VarChar(30)
  size           String  @db.VarChar(10)
  unitPriceMinor Int     @map("unit_price_minor")
  quantity       Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @db.VarChar(30)
  providerReference String        @unique @map("provider_reference") @db.VarChar(120)
  status            PaymentStatus @default(PENDING)
  amountMinor       Int           @map("amount_minor")
  currency          String        @db.Char(3)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @db.VarChar(30)
  eventId    String   @map("event_id") @db.VarChar(120)
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("payment_events")
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  authorName String       @map("author_name") @db.VarChar(80)
  rating     Int
  title      String       @db.VarChar(120)
  body       String       @db.VarChar(2000)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@map("reviews")
}

model NewsletterSubscriber {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(254)
  status           SubscriberStatus @default(PENDING)
  consentAt        DateTime         @map("consent_at")
  confirmTokenHash String?          @unique @map("confirm_token_hash") @db.VarChar(64)
  confirmedAt      DateTime?        @map("confirmed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  message   String   @db.VarChar(4000)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String   @map("entity_id") @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("audit_logs")
}
